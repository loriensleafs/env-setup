{
  "name": "envsetup",
  "version": "0.1.3",
  "description": "One-command interactive Mac environment setup — bootstrap, doctor, sync",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "md:lint": "markdownlint-cli2",
    "md:fix": "markdownlint-cli2 --fix",
    "fix": "biome check --write . && markdownlint-cli2 --fix",
    "check": "biome check . && bun tsc --noEmit && markdownlint-cli2",
    "changelog": "git-cliff -o CHANGELOG.md",
    "compile": "bun build --compile src/index.ts --outfile dist/envsetup",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clack/core": "./vendor/clack-core-1.4.3-main-20260815.tgz",
    "@clack/prompts": "./vendor/clack-prompts-1.7.0-main-20260815.tgz",
    "age-encryption": "^0.3.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "sisteransi": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@clack/core": "./vendor/clack-core-1.4.3-main-20260815.tgz"
  }
}
