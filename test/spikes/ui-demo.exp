#!/usr/bin/expect -f
# PTY smoke test for the unified prompt + radio demo.
set stty_init "rows 40 columns 120"
set timeout 10
spawn bun src/ui/demo.ts
expect { "What should this machine get?" {} timeout { puts stderr "NO-RENDER"; exit 1 } }
# toggle ghostty OFF: cursor starts on chrome; down->ghostty; space
send "\033\[B"; after 150; send " "; after 200
# dependent should disappear — toggle ghostty back ON
send " "; after 200
# submit the multiselect
send "\r"
expect { -re "selected:.*ghostty-config" {} timeout { puts stderr "DEP-RESTORE-FAIL"; exit 1 } }
expect { "effort level" {} timeout { puts stderr "NO-RADIO"; exit 1 } }
send "\033\[D"; after 150; send "\r"
# the process exits right after printing — match both before EOF in one pattern
expect {
  -re "effort: medium(.|\n)*demo complete" { exit 0 }
  "effort: medium" { expect { "demo complete" { exit 0 } eof { exit 0 } } }
  timeout { puts stderr "RADIO-VALUE-FAIL"; exit 1 }
  eof { puts stderr "EARLY-EOF"; exit 1 }
}
