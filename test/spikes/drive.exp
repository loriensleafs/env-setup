#!/usr/bin/expect -f
set stty_init "rows 40 columns 120"
set timeout 6
spawn {*}$argv
for {set i 1} {$i <= 18} {incr i} {
  expect {
    -re "Prompt $i/18\[^\r\n]*\r" { after 120; send "\r"; puts stderr "OK:$i" }
    timeout { puts stderr "STALL_AT:$i"; exit 1 }
  }
}
expect { "Multiselect" { after 120; send "\r"; puts stderr "OK:ms" } timeout { puts stderr "STALL:ms"; exit 1 } }
expect { "horizontal radio" { after 120; send "\033\[C\r"; puts stderr "OK:radio" } timeout { puts stderr "STALL:radio"; exit 1 } }
expect { "SPIKE PASSED" { puts stderr "ALL-OK"; exit 0 } timeout { puts stderr "STALL:end"; exit 1 } }
