{
  // markdownlint-cli2 config (auto-discovered). Tuned for long-form prose docs.
  "config": {
    "default": true,
    "MD013": false, // line-length: docs/PLAN.md intentionally uses long lines
    "MD033": false, // inline HTML: allowed (occasional <br>, details)
    "MD041": false, // first-line-heading: some docs open with a note/badge
    "MD024": { "siblings_only": true }, // duplicate headings ok across sections
    "MD025": false, // PLAN.md uses multiple top-level `#` section dividers by design
    "MD029": { "style": "ordered" }, // ordered lists: 1. 2. 3.
    "MD049": false, // emphasis style (_ vs *): not enforced across long-form notes
    "MD007": { "indent": 2 }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "dist",
    "vendor",
    "CHANGELOG.md" // generated by git-cliff; not hand-linted
  ]
}
