{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "spikes"
  ],
  "exclude": [
    "src/items/*/assets"
  ]
}